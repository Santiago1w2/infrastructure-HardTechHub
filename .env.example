# Puertos publicados en la EC2 Database; coinciden con los Security Groups.
POSTGRES_PORT=5432
MYSQL_PORT=3306
MONGO_PORT=27017

# Cuenta tecnica del catalogo en PostgreSQL (hardtech_catalog).
CATALOG_POSTGRES_PASSWORD=CAMBIAR_CATALOGO
# Pedidos en MySQL (hardtech_orders).
MYSQL_PASSWORD=CAMBIAR_PEDIDOS
# Inventario en MongoDB (hardtech_inventory).
INVENTORY_MONGO_PASSWORD=CAMBIAR_INVENTARIO

# Credenciales administrativas de las bases.
POSTGRES_PASSWORD=CAMBIAR_ADMIN_POSTGRES
MYSQL_ROOT_PASSWORD=CAMBIAR_ADMIN_MYSQL
MONGO_INITDB_ROOT_PASSWORD=CAMBIAR_ADMIN_MONGO